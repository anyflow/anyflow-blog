---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absoluteUrl | escape }}</loc></url>
{% for post in posts %}{% if not post.noindex %}  <url><loc>{{ post.url | absoluteUrl | escape }}</loc></url>
{% endif %}{% endfor %}{% for page in categoryPages %}{% if not page.noindex %}  <url><loc>{{ page.url | absoluteUrl | escape }}</loc></url>
{% endif %}{% endfor %}</urlset>

{% for group in categories %}<section class="category-group" data-category="{{ group.name | escape }}" style="{{ (group.name | tagColor) | tagStyle }}"><h3 class="category-heading">{{ icon(group.visual) }}{% if group.url %}<a class="category-label" href="{{ group.url | escape }}">{{ group.name | escape }}</a>{% else %}<span class="category-label">{{ group.name | escape }}</span>{% endif %} <span class="category-count">{{ group.posts.length }}</span></h3><div id="category-{{ loop.index }}">{% for item in group.posts %}<a class="category-row" href="{{ item.url }}" {% if loop.index>10 %}hidden{% endif %}>{{ icon(item) }}<span class="row-title">{{ item.title | escape }}</span><time datetime="{{ item.date }}">{{ item.displayDate }}</time></a>{% endfor %}</div>{% if group.posts.length>10 %}<button class="load-more" data-load-more="category-{{ loop.index }}" type="button"><svg viewBox="0 0 30 30" aria-hidden="true"><polygon points="24.594 16.594 16 25.188 16 1 14 1 14 25.188 5.406 16.594 4 18 15 29 26 18"></polygon></svg><span>Load more</span></button>{% endif %}</section>{% endfor %}

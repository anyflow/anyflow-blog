{% for group in categories %}<details class="category-group" data-category="{{ group.name | escape }}" style="{{ (group.name | tagColor) | tagStyle }}" open><summary><span class="category-label">{{ group.name | escape }}</span> <span class="category-count">{{ group.posts.length }}</span></summary><div id="category-{{ loop.index }}">{% for item in group.posts %}<a class="category-row" href="{{ item.url }}" {% if loop.index>10 %}hidden{% endif %}>{{ icon(item) }}<span class="row-title">{{ item.title | escape }}</span><time datetime="{{ item.date }}">{{ item.displayDate }}</time></a>{% endfor %}</div>{% if group.posts.length>10 %}<button class="load-more" data-load-more="category-{{ loop.index }}" type="button"><svg viewBox="0 0 30 30" aria-hidden="true"><polygon points="24.594 16.594 16 25.188 16 1 14 1 14 25.188 5.406 16.594 4 18 15 29 26 18"></polygon></svg><span>Load more</span></button>{% endif %}</details>{% endfor %}

{% macro tag(label, searchable=false) %}{% if searchable %}{% set display = label | replace(r/-/g, ' ') %}<button type="button" class="tag tag-filter" style="{{ (label | tagColor) | tagStyle }}" data-search-tag="{{ label | escape }}" aria-label="{{ display | escape }} 태그로 검색" aria-haspopup="dialog" aria-controls="search-dialog">{{ display | escape }}</button>{% else %}<span class="tag" style="{{ (label | tagColor) | tagStyle }}">{{ label | escape }}</span>{% endif %}{% endmacro %}

{% macro tag(label, colors, searchable=false) %}{% if searchable %}<button type="button" class="tag tag-filter" style="{{ (colors[label] or (label | tagColor)) | tagStyle }}" data-search-tag="{{ label | escape }}" aria-label="{{ label | escape }} 태그로 검색" aria-haspopup="dialog" aria-controls="search-dialog">{{ label | escape }}</button>{% else %}<span class="tag" style="{{ (colors[label] or (label | tagColor)) | tagStyle }}">{{ label | escape }}</span>{% endif %}{% endmacro %}

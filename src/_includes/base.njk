<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — {{ site.title }}</title>
  <meta name="description" content="{{ summary or site.description }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ summary or site.description }}">
  <meta property="og:type" content="{% if kind == 'post' %}article{% else %}website{% endif %}">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-logo">{{ site.title }}</a>
      <nav class="header-nav">
        <button class="search-btn" aria-label="Search">Search</button>
        <button class="theme-toggle" aria-label="Toggle dark mode">🌙</button>
      </nav>
    </div>
  </header>

  <main class="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>&copy; {{ site.author }}</p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>

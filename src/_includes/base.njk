{% from "tags.njk" import tag %}
{% from "icon.njk" import icon %}
{% set visual = categoryPage or post or home %}
{% set pageTitle = visual.title or site.title %}
{% set pageDescription = visual.summary or site.description %}
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle | escape }}</title>
  <link rel="alternate" type="application/rss+xml" title="{{ (home.title or site.title) | escape }} — RSS" href="{{ "/rss.xml" | absoluteUrl | escape }}">
  <meta name="description" content="{{ pageDescription | escape }}">
  {% if visual.noindex %}<meta name="robots" content="noindex">{% endif %}
  <meta property="og:title" content="{{ pageTitle | escape }}">
  <meta property="og:description" content="{{ pageDescription | escape }}">
  <meta property="og:type" content="{% if post %}article{% else %}website{% endif %}">
  <link rel="canonical" href="{{ (visual.url or '/') | absoluteUrl | escape }}">
  <meta property="og:url" content="{{ (visual.url or '/') | absoluteUrl | escape }}">
  {% set shareImage = visual.ogImage or visual.thumbnail or visual.cover or home.cover %}
  {% if shareImage %}<meta property="og:image" content="{{ shareImage | absoluteUrl | escape }}">{% endif %}
  {% if post %}<meta data-pagefind-meta="tags[content]" content="{{ post.tags | join(' ') | escape }}">{% for name in post.tags %}<meta data-pagefind-filter="tag[content]" content="{{ name | replace(r/[-\s]+/g, ' ') | trim | lower | escape }}">{% endfor %}{% endif %}
  {% if home.favicon %}<link rel="icon" href="{{ home.favicon | escape }}"><link rel="apple-touch-icon" href="{{ home.favicon | escape }}">{% endif %}
  <script>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||'light'}catch{}</script>
  <link rel="stylesheet" href="/vendor/katex/katex.min.css">
  <link rel="stylesheet" href="{{ '/css/style.css' | versionedAsset }}">
  <link rel="stylesheet" href="{{ '/css/link-previews.css' | versionedAsset }}">
  <script defer src="/js/vendor/highlight.min.js"></script><script defer src="{{ '/js/vendor/mermaid-profile.js' | versionedAsset }}"></script><script defer src="{{ '/js/main.js' | versionedAsset }}" data-mermaid-src="{{ '/js/vendor/mermaid.min.js' | versionedAsset }}"></script>
  <script defer src="{{ '/js/search.js' | versionedAsset }}"></script>
  <script defer src="{{ '/js/share.js' | versionedAsset }}"></script>
  {% if post %}<script defer src="{{ '/js/image-viewer.js' | versionedAsset }}"></script>{% endif %}
  {% if not categoryPage %}<link rel="stylesheet" href="{{ '/css/comments.css' | versionedAsset }}"><script defer src="{{ '/js/comments.js' | versionedAsset }}"></script>{% endif %}
  {% if site.analyticsId %}<script defer src="{{ '/js/analytics.js' | versionedAsset }}" data-measurement-id="{{ site.analyticsId | escape }}" data-hostnames="{{ site.analyticsHosts | join(',') | escape }}"></script>{% endif %}
</head>
<body>
<header class="site-header">
  <nav class="breadcrumbs" aria-label="위치"><a class="site-logo" href="/">{{ icon(home) }} <span>{{ (home.title or site.title) | escape }}</span></a>{% if post %}<span class="crumb-divider">/</span>{% if post.category %}{% set categoryLink = categoryUrls[post.category] %}{% if categoryLink %}<a class="category-crumb" href="{{ categoryLink | escape }}" title="{{ post.category | escape }}">{{ post.category | escape }}</a>{% else %}<span class="category-crumb" title="{{ post.category | escape }}">{{ post.category | escape }}</span>{% endif %}<span class="crumb-divider">/</span>{% endif %}<a class="post-crumb" href="{{ post.url }}">{{ icon(post) }} <span>{{ post.title | escape }}</span></a>{% elif categoryPage %}<span class="crumb-divider">/</span><a class="category-crumb" href="{{ categoryPage.url | escape }}" title="{{ categoryPage.title | escape }}" aria-current="page">{{ categoryPage.title | escape }}</a>{% endif %}</nav>
  <div class="header-actions">
    <button class="search-button" type="button" aria-label="Search" title="검색" aria-haspopup="dialog" aria-controls="search-dialog"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8" cy="8" r="5.7"/><path d="m12.5 12.5 4.5 4.5"/></svg><span>Search</span></button>
    <a class="rss-link" href="/rss.xml" type="application/rss+xml" aria-label="RSS 구독" title="RSS 구독"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="4" cy="16" r="1.6" fill="currentColor" stroke="none"/><path d="M3 9a8 8 0 0 1 8 8M3 3a14 14 0 0 1 14 14"/></svg><span>RSS</span></a>
    <button class="share-button" type="button" aria-label="Share" title="공유" popovertarget="share-menu" aria-haspopup="dialog"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 7H4a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1h-2M10 12V2M6.5 5.5 10 2l3.5 3.5"/></svg><span>Share</span></button>
    <div id="share-menu" class="share-menu" popover="auto" role="dialog" aria-label="공유">
      <button class="share-option share-copy" type="button" aria-label="링크 복사" title="Copy link" autofocus><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 13 4-4M8 16l-1 1a4 4 0 0 1-6-6l5-5a4 4 0 0 1 6 0m0 12a4 4 0 0 0 6 0l5-5a4 4 0 0 0-6-6l-1 1"/></svg></button>
      <a class="share-option" href="https://www.facebook.com/sharer/sharer.php?display=popup&amp;u=" data-share-base="https://www.facebook.com/sharer/sharer.php?display=popup&amp;u=" aria-label="Facebook에 공유" title="Facebook" target="_blank" rel="noopener noreferrer"><img src="/images/reference/share/facebook.png" alt="" width="30" height="30"></a>
      <a class="share-option" href="https://twitter.com/intent/tweet?text=&amp;url=" data-share-base="https://twitter.com/intent/tweet?text=&amp;url=" aria-label="X에 공유" title="X (Twitter)" target="_blank" rel="noopener noreferrer"><img src="/images/reference/share/twitter.png" alt="" width="30" height="30"></a>
      <a class="share-option" href="https://www.linkedin.com/shareArticle?mini=true&amp;url=" data-share-base="https://www.linkedin.com/shareArticle?mini=true&amp;url=" aria-label="LinkedIn에 공유" title="LinkedIn" target="_blank" rel="noopener noreferrer"><img src="/images/reference/share/linkedin.png" alt="" width="30" height="30"></a>
      <a class="share-option" href="https://www.pinterest.co.kr/pin/create/link/?url=" data-share-base="https://www.pinterest.co.kr/pin/create/link/?url=" aria-label="Pinterest에 공유" title="Pinterest" target="_blank" rel="noopener noreferrer"><img src="/images/reference/share/pinterest.png" alt="" width="30" height="30"></a>
    </div>
    <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Turn on the dark mode" title="어두운 테마로 전환"><span class="theme-knob"></span><img class="theme-symbol" src="/images/reference/sun.png" alt=""></button>
  </div><div class="reading-progress"></div>
</header>
{% set cover = visual.cover %}
{% if cover %}<div class="page-cover"><img src="{{ cover | escape }}" alt="" style="object-position:{{ visual.coverPosition | escape }}"></div>{% else %}<div class="page-cover empty-cover"></div>{% endif %}
<div class="page-header page-width">
  {% if visual.icon or visual.iconImage %}<div class="page-icon">{{ icon(visual,true) }}</div>{% endif %}
  <h1 class="page-title">{{ pageTitle | escape }}</h1>
  {% if post %}<div class="properties">
    <div class="property-row"><div class="property-label"><svg viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="7" fill="currentColor" stroke="none"/><path d="m6 7.5 3 3 3-3" stroke="var(--bg)"/></svg>Category</div><div class="property-value">{{ tag(post.category) }}</div></div>
    <div class="property-row"><div class="property-label"><svg viewBox="0 0 18 18" aria-hidden="true"><path d="M7 5h8M7 9h8M7 13h8"/><circle cx="3" cy="5" r=".8"/><circle cx="3" cy="9" r=".8"/><circle cx="3" cy="13" r=".8"/></svg>Tags</div><div class="property-value">{% if post.tags.length %}{% for name in post.tags %}{{ tag(name,true) }}{% endfor %}{% else %}<span class="property-empty">None</span>{% endif %}</div></div>
    <div class="property-row"><div class="property-label"><svg viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="4" width="12" height="11" rx="1"/><path d="M3 7h12M6 2v4M12 2v4M6 10h6M6 12h4"/></svg>Created time</div><div class="property-value date-property">{{ post.displayDate }}</div></div>
    <div class="property-row"><div class="property-label"><svg viewBox="0 0 18 18" aria-hidden="true"><rect x="3" y="4" width="12" height="11" rx="1"/><path d="M3 7h12M6 2v4M12 2v4M6 10h6M6 12h4"/></svg>Updated time</div><div class="property-value date-property">{% if post.updated %}{{ post.updated | dateLabel }}{% else %}<span class="property-empty">None</span>{% endif %}</div></div>
  </div>{% endif %}
</div>
<div class="page-layout page-width">
  <main class="content {% if post %}post-content{% else %}home-content{% endif %}" id="main-content">{{ content | safe }}</main>
  <nav class="toc" aria-label="목차">{% set pageToc = visual.toc %}{% for item in pageToc %}<a href="#{{ item.id }}" class="toc-level-{{ item.level }}" title="{{ item.text | escape }}">{{ item.text | escape }}</a>{% endfor %}</nav>
</div>
<button class="back-to-top" type="button" aria-label="맨 위로">⌃ <span>TOP</span></button>
<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
  <div class="search-heading"><h2 id="search-title">블로그 검색</h2><button type="button" class="search-close" aria-label="검색 닫기">✕</button></div>
  <label class="search-label" for="search-input">제목·태그·본문 검색</label>
  <input id="search-input" class="search-input" type="search" placeholder="검색어를 입력하세요" autocomplete="off" aria-controls="search-results" aria-describedby="search-status" autofocus>
  <button class="search-filter" type="button" aria-label="태그 필터 해제" hidden></button>
  <p id="search-status" class="search-status" role="status" aria-live="polite">검색어를 입력하세요.</p>
  <div class="search-results-scroll"><ul id="search-results" class="search-results" aria-label="검색 결과"></ul><button class="search-more" type="button" hidden>더 보기</button></div>
  <p class="search-help">정확한 문구는 &quot;검색어&quot;처럼 큰따옴표로 묶어 검색하세요.</p>
</dialog>
<div class="toast" role="status" aria-live="polite"></div>
</body></html>

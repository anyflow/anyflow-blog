---
layout: base.njk
---
{% from "tags.njk" import tag %}
{% from "icon.njk" import icon %}
{% for section in home.sections %}
<section class="{{ section.className }}"{% if section.id %} aria-labelledby="{{ section.id | escape }}"{% endif %}>
{% for part in section.parts %}
{% if part.kind == "html" %}{{ part.html | safe }}
{% elif part.kind == "recent" %}{% include "home-recent.njk" %}
{% elif part.kind == "categories" %}{% include "home-categories.njk" %}
{% elif part.kind == "profileLinks" %}
<div class="profile-columns">{{ part.html | safe }}<a class="bookmark" href="{{ part.link.url | escape }}" target="_blank" rel="noopener noreferrer"><div><span>{{ part.link.title | escape }}</span><small>{{ icon(part.link) }} {{ part.displayUrl | escape }}</small></div>{% if part.link.thumbnail or part.link.cover %}<img src="{{ (part.link.thumbnail or part.link.cover) | escape }}" alt="">{% endif %}</a></div>
{% endif %}
{% endfor %}
</section>
{% endfor %}

<section id="comments" class="comments" data-post-id="{{ home.id | escape }}" data-pagefind-ignore aria-labelledby="comments-title">
  <h2 id="comments-title">Comments</h2>
  <noscript>댓글을 보려면 JavaScript를 켜 주세요.</noscript>
</section>

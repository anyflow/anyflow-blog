FROM alpine:3.22 AS kubectl
RUN apk add --no-cache curl \
    && curl --fail --location --retry 3 https://dl.k8s.io/release/v1.35.0/bin/linux/amd64/kubectl -o /kubectl \
    && curl --fail --location --retry 3 https://dl.k8s.io/release/v1.35.0/bin/linux/amd64/kubectl.sha256 -o /kubectl.sha256 \
    && echo "$(cat /kubectl.sha256)  /kubectl" | sha256sum -c - \
    && chmod 755 /kubectl
FROM alpine:3.22
RUN apk add --no-cache git openssh-client make util-linux-misc \
    && addgroup -g 1000 deploy && adduser -D -u 1000 -G deploy deploy
COPY --from=kubectl /kubectl /usr/local/bin/kubectl
COPY --chmod=755 scripts/poll-deploy.sh /usr/local/bin/poll-deploy
USER 1000:1000
ENV HOME=/tmp
ENTRYPOINT ["/usr/local/bin/poll-deploy"]
